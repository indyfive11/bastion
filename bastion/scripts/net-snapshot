#!/usr/bin/env bash
# net-snapshot — capture current known-good network state for net-rollback.
# Runs as root — invoked directly by its callers (bastion snapshot/switch, the wizard, edge-watchdog);
# there is no net-snapshot.service unit. Default target is /var/lib/net-safe/snapshot (the AUTO
# slot net-rollback + the watchdog use); an optional $1 captures to a different dir instead, so a
# NAMED snapshot is written straight to its own slot WITHOUT clobbering the auto slot (F10).
STATE=/var/lib/net-safe; SNAP="${1:-$STATE/snapshot}"
# Marker write, extracted (and defined BEFORE the machine.env source so a unit test injecting stubs at
# that line can override it) so a test can force it to fail — simulating a transient EIO on the tiny
# known-good firewall marker, which would otherwise leave net-rollback with no firewall to restore.
write_marker(){ : > "$1"; }
# NFT_TABLE (inet edge on edge, inet bastion on endpoint) — must match net-rollback's
# edge_loaded() or the firewall-manager baseline inverts. Generic fallback keeps topology out
# of the repo; the live node always has machine.env.
[ -r /etc/bastion/machine.env ] && . /etc/bastion/machine.env
# Testability + override seams: the authoritative NM profile dir and the resolver file. Default to the
# real host paths (zero production change); the unit tests point them at fixtures so the completeness
# gate below can be exercised hermetically (the dev box is a live node with real NM profiles).
NM_DIR=${NM_DIR:-/etc/NetworkManager/system-connections}
RESOLV_CONF=${RESOLV_CONF:-/etc/resolv.conf}
log(){ logger -t net-safe "net-snapshot: $*"; }

# Atomic-swap capture (item 3): build the whole capture in a hidden sibling temp dir and swap it into
# place ONLY once it is complete, instead of rewriting the live slot in place. Two properties this buys
# over the old in-place rewrite: (1) a failed/truncated capture (e.g. disk full) NEVER touches the live
# slot — a complete-but-stale known-good beats a torn-fresh one; (2) a reader (net-rollback, the
# watchdog) never observes a half-written slot — it sees the old complete slot, then the new complete
# slot, with only a rename-sized gap where the slot is briefly absent (which every reader already
# handles fail-safe). `mv -T` never nests, so a rare concurrent capture can't corrupt the slot; the
# moved-aside PREV lets a crash mid-swap be reconciled (below, and at the top of net-rollback).
PARENT=${SNAP%/*}; BASE=${SNAP##*/}
NEW="$PARENT/.$BASE.new.$$"; PREV="$PARENT/.$BASE.prev"
trap 'rm -rf "$NEW"' EXIT

# Reconcile a snapshot orphaned by a crash mid-swap (or a non-durable rename after power loss): if the
# slot vanished but the moved-aside copy survived, promote it before doing anything else.
if [ ! -e "$SNAP" ] && [ -e "$PREV" ]; then
  mv -T "$PREV" "$SNAP" 2>/dev/null && log "recovered known-good slot from an interrupted swap (.prev)"
fi

mkdir -p /run/net-safe
# 0700 on the temp (umask 077): the NM connection copies below carry PSKs/secrets; the swap carries
# this mode onto the live slot, so the known-good dir ends up 0700 (tighter than the old 0755).
(umask 077; rm -rf "$NEW"; mkdir -p "$NEW/nm-system-connections")

# Authoritative static config (IP / gateway / DNS live in the NM profiles). Sample the source profile
# count BEFORE the copy so the completeness gate compares against a frozen number, not a re-count that
# could race NM rewriting a profile mid-snapshot (boot / `bastion setup`).
src_nm=$(ls -1 "$NM_DIR"/*.nmconnection 2>/dev/null | wc -l)
cp -a "$NM_DIR/." "$NEW/nm-system-connections/" 2>/dev/null || true
# DNS resolver file
cp -P "$RESOLV_CONF" "$NEW/resolv.conf" 2>/dev/null || true
# Operational state (for restore + audit)
ip route show table main  > "$NEW/routes.txt"        2>/dev/null || true
ip route show default     > "$NEW/default-route.txt" 2>/dev/null || true
ip -br addr               > "$NEW/addrs.txt"         2>/dev/null || true
# Was dnsmasq active at snapshot? (so rollback knows whether to stop it)
if systemctl is-active --quiet dnsmasq; then : > "$NEW/dnsmasq-was-active"
else : > "$NEW/dnsmasq-was-inactive"; fi

# Firewall known-good: which manager DRIVES THE LIVE RULESET at snapshot time?
# Detect by the actual loaded ruleset, NOT service unit state: ufw.service can
# linger "active" after the edge table took over (it leaves a zombie unit even
# though its iptables chains were flushed), and nftables.service is oneshot. The
# governing firewall is whoever owns the live ruleset. This MUST agree with
# net-rollback's edge_loaded() or the baseline inverts (the 2026-06-05 flap).
# net-rollback restores THIS manager: edge => reload nftables; ufw => restart ufw.
if nft list table ${NFT_TABLE:-inet edge} >/dev/null 2>&1; then
  write_marker "$NEW/fw-nftables-active" || fw_marker_failed=1
elif systemctl is-active --quiet ufw; then
  write_marker "$NEW/fw-ufw-active" || fw_marker_failed=1
fi
# Live rulesets — forensic/audit only; restore is service-driven, not blob-replay.
nft list ruleset > "$NEW/nft-ruleset.txt" 2>/dev/null || true
iptables-save    > "$NEW/iptables.txt"    2>/dev/null || true
ip6tables-save   > "$NEW/ip6tables.txt"   2>/dev/null || true

# --- Completeness gate (H2): a capture WRITE can fail silently (disk pressure, a transient EIO) while
# the tiny taken-at write below still succeeds — which would swap a content-INCOMPLETE slot in as
# known-good and let a later net-rollback "restore" from it and report success. So require the
# RESTORE-RELEVANT captures this host should have produced to have actually landed, BEFORE stamping the
# slot complete. Each clause SKIPS when its source is legitimately absent (an NM-less endpoint, a box
# with no resolver, a firewall-less box) so a sparse-but-valid host never false-fails and disables its
# own safety net. Logs stay generic — counts only, never a profile name or resolver contents. NOT
# gated (survivable, so gating would only add false-incomplete risk): default-route.txt (net-rollback
# has a GATEWAY fallback) and the dnsmasq marker (its loss only skips a non-lifeline stop).
capture_ok=1
# NM profiles: the frozen copy must hold at least the pre-copy source count (>= tolerates a concurrent
# add/delete), and no profile may be zero-length (a truncated copy). Skip when NM manages nothing here.
if [ "${src_nm:-0}" -gt 0 ]; then
  dst_nm=$(ls -1 "$NEW/nm-system-connections/"*.nmconnection 2>/dev/null | wc -l)
  # Compare against min(count before cp, count now): a profile legitimately ADDED or DELETED between
  # the pre-cp sample and here is not a capture failure — only a copy that landed fewer than the source
  # actually held is. Keeps a concurrent NM edit (boot / `bastion setup`) from false-failing the capture.
  now_nm=$(ls -1 "$NM_DIR"/*.nmconnection 2>/dev/null | wc -l)
  floor=$src_nm; [ "$now_nm" -lt "$floor" ] && floor=$now_nm
  if [ "$dst_nm" -lt "$floor" ]; then
    capture_ok=0; log "capture incomplete (content): NM profiles captured $dst_nm of $floor"
  else
    for f in "$NEW/nm-system-connections/"*.nmconnection; do
      [ -e "$f" ] || continue
      [ -s "$f" ] && continue
      # A zero-length COPY is a failure only if the source counterpart had content (a truncated write);
      # an already-empty source faithfully reproduced by cp is NOT — else one stray 0-byte profile on
      # the host would disable snapshotting forever.
      [ -s "$NM_DIR/${f##*/}" ] || continue
      capture_ok=0; log "capture incomplete (content): an NM profile copied empty"; break
    done
  fi
fi
# resolv.conf is stored verbatim as a SYMLINK by design (cp -P), so completeness = the copy exists as a
# file OR a symlink; NEVER deref the target (a relative/absent stub target would false-fail a valid
# capture — the field-vs-dev trap). Skip when the host has no resolver file at all.
if [ -e "$RESOLV_CONF" ] || [ -L "$RESOLV_CONF" ]; then
  [ -e "$NEW/resolv.conf" ] || [ -L "$NEW/resolv.conf" ] \
    || { capture_ok=0; log "capture incomplete (content): resolv.conf copy missing"; }
fi
# Firewall known-good marker: if a firewall was detected active above, its marker write must have
# landed, else net-rollback would restore NO firewall (both markers absent). Only fires on a failed
# marker WRITE — a firewall-less box legitimately has neither marker (fw_marker_failed stays unset).
[ "${fw_marker_failed:-0}" = 1 ] && { capture_ok=0; log "capture incomplete (content): firewall known-good marker not written"; }

# `taken-at` is the COMPLETION witness — written last, after every restore-relevant file. If the
# content gate above failed, or taken-at itself can't be written (disk full), the capture is
# incomplete: leave the PRIOR slot untouched and fail, rather than swap in a partial. net-rollback
# also treats a slot with no taken-at as incomplete (belt-and-braces for the reconcile/legacy cases).
if [ "$capture_ok" = 1 ] && { date -Iseconds > "$NEW/taken-at" 2>/dev/null || date > "$NEW/taken-at"; }; then
  # Swap the complete capture in. Move the current slot aside to PREV first (so a crash between the two
  # renames leaves recoverable data), put the new slot in with `mv -T` (never nests), then guarantee a
  # slot exists (restore the aside if a rare concurrent capture won the slot and ours didn't land).
  rm -rf "$PREV"
  [ -e "$SNAP" ] && mv -T "$SNAP" "$PREV" 2>/dev/null
  mv -T "$NEW" "$SNAP" 2>/dev/null
  [ -e "$SNAP" ] || mv -T "$PREV" "$SNAP" 2>/dev/null
  # Drop the aside ONLY if a valid slot is in place. If both renames somehow failed (slot absent),
  # KEEP PREV — it's the only surviving good copy, and net-rollback's reconcile will promote it.
  [ -e "$SNAP" ] && rm -rf "$PREV"
else
  [ "$capture_ok" = 1 ] && log "capture incomplete (could not write taken-at) — kept the prior snapshot, NOT swapping"
  exit 1
fi

DEF="$(cat "$SNAP/default-route.txt" 2>/dev/null)"
FW="none"; [ -f "$SNAP/fw-ufw-active" ] && FW="ufw"; [ -f "$SNAP/fw-nftables-active" ] && FW="nftables"
log "captured known-good state -> $SNAP  (default: ${DEF:-NONE}; firewall: $FW)"
