#!/usr/bin/env python3
# edge-ai-analyze — the UNPRIVILEGED analyzer (runs as user edge-ai; no sudo, no nft).
#
# Reads the sanitized /var/lib/edge-ai/signals.json, invokes the configured pluggable
# BACKEND_CMD (signals on stdin -> intent-envelope JSON on stdout), validates the result
# against intent.schema.json, stamps each intent with an ABSOLUTE `expires` epoch, and
# atomically writes /var/lib/edge-ai/intents.json. The reconciler (root) re-validates and
# applies. This process can NEVER touch the firewall.
#
# Self-heal: absolute expiry means a DEAD analyzer's blocks count down and drop out even
# though intents.json persists (the reconciler applies timeout = expires - now). On ANY
# error we leave the previous intents.json UNTOUCHED so its entries keep expiring normally.
#
import json, os, re, selectors, shlex, signal, subprocess, sys, time

_CTRL_RE = re.compile(r"[\x00-\x1f\x7f]")   # C0 controls + DEL (ANSI ESC \x1b, CR/LF, tab, ...)
def _clean(s, n):
    """Strip control chars from model-origin free text and length-cap it (D6). The reason/description
    a backend returns reach the operator's terminal (edge-ctl) and the journal verbatim; a crafted
    ANSI/escape sequence there could spoof output or inject log lines. One-liners only — newlines/tabs
    go too."""
    return _CTRL_RE.sub("", str(s))[:n]

BACKENDCONF = "/etc/edge-ai/backend.conf"
SCHEMA      = "/etc/edge-ai/intent.schema.json"
SIGNALS     = "/var/lib/edge-ai/signals.json"
INTENTS     = "/var/lib/edge-ai/intents.json"
PROPOSALS   = "/var/lib/edge-ai/proposals.jsonl"   # human-review queue (propose_base_change)
APPLY_ACTIONS = {"block_src", "ratelimit_src", "tarpit_src"}
MAX_STDERR_BYTES = 1 << 16       # only stderr[:300] is ever surfaced; 64 KiB is ample headroom
MAX_TOTAL_INTENTS = 512          # hard ceiling on intents PROCESSED per run — bounds the proposals
                                 # path (the applied-only MAX_INTENTS break does NOT limit proposals)


class BackendTimeout(Exception):
    """Backend ran past BACKEND_TIMEOUT."""


class BackendTooBig(Exception):
    """Backend wrote past the byte ceiling on the named stream ('out' | 'err')."""
    def __init__(self, stream):
        super().__init__(stream)
        self.stream = stream

def log(m): sys.stderr.write(f"edge-ai-analyze: {m}\n")
def die(m, code=1):
    log(m); log("leaving previous intents.json untouched (self-heal via TTL)"); sys.exit(code)

def load_conf():
    cfg = {"BACKEND_CMD": "/usr/local/sbin/edge-ai-backend-mock", "MODEL": "claude-opus-4-8",
           "MAX_INTENTS": 32, "MAX_TTL": 86400, "MIN_TTL": 60, "BACKEND_TIMEOUT": 60,
           "MAX_OUTPUT_BYTES": 1 << 20}
    try:
        with open(BACKENDCONF) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if not line or "=" not in line: continue
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip()
    except FileNotFoundError:
        log(f"WARNING: {BACKENDCONF} missing, using defaults")
    for k in ("MAX_INTENTS", "MAX_TTL", "MIN_TTL", "BACKEND_TIMEOUT", "MAX_OUTPUT_BYTES"):
        try: cfg[k] = int(cfg[k])
        except (ValueError, TypeError): pass
    # A malformed backend.conf override for the memory ceiling must never survive as a string (it
    # feeds a bounded read) — fall back to the safe default rather than crash the analyzer later.
    if not (isinstance(cfg["MAX_OUTPUT_BYTES"], int) and cfg["MAX_OUTPUT_BYTES"] > 0):
        cfg["MAX_OUTPUT_BYTES"] = 1 << 20
    # Upper-clamp so a fat-fingered override can't silently disable the in-process ceiling (which
    # would leave only the cgroup MemoryMax as the bound). 64 MiB is far past any real envelope.
    cfg["MAX_OUTPUT_BYTES"] = min(cfg["MAX_OUTPUT_BYTES"], 64 << 20)
    return cfg

def _kill_group(p):
    """SIGKILL the child's whole process group (a pluggable BACKEND_CMD may fork), falling back to
    killing just the child if the group is already gone."""
    try:
        os.killpg(os.getpgid(p.pid), signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        try:
            p.kill()
        except ProcessLookupError:
            pass


def run_backend(cmd, signals_path, timeout, env, max_bytes):
    """Invoke the pluggable backend and read its stdout/stderr under a hard byte ceiling + a
    wall-clock deadline, so a hung / compromised / local backend cannot OOM this (unprivileged)
    analyzer by streaming unbounded output. Returns ``(returncode, stdout_text, stderr_text)``.

    Design (M7): the signals FILE is handed to the child as its stdin fd — no parent-side stdin
    write — which structurally removes the stdin-pipe deadlock and any BrokenPipe. stdout is capped
    at ``max_bytes``, stderr at ``MAX_STDERR_BYTES``; exceeding either kills the child's process
    group and raises :class:`BackendTooBig`. The deadline is ABSOLUTE (``time.monotonic()``), so a
    slow-drip backend that dribbles under the cap is still cut at ``timeout`` (:class:`BackendTimeout`).
    The child is always reaped. NOT ``subprocess.run``/``communicate`` — those buffer both pipes
    unbounded into this process before any size can be checked."""
    out_buf, err_buf = bytearray(), bytearray()
    with open(signals_path, "rb") as sf, subprocess.Popen(
            cmd, stdin=sf, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            env=env, start_new_session=True) as p:
        streams = {p.stdout.fileno(): ("out", out_buf, max_bytes),
                   p.stderr.fileno(): ("err", err_buf, MAX_STDERR_BYTES)}
        sel = selectors.DefaultSelector()
        for f in (p.stdout, p.stderr):
            os.set_blocking(f.fileno(), False)
            sel.register(f, selectors.EVENT_READ)
        deadline = time.monotonic() + timeout
        verdict = None
        try:
            while sel.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0:                    # absolute deadline: defeats a slow drip
                    verdict = "timeout"; break
                events = sel.select(remaining)
                if not events:                        # select() itself hit the deadline
                    verdict = "timeout"; break
                for key, _ in events:
                    try:
                        chunk = os.read(key.fd, 65536)
                    except BlockingIOError:
                        continue
                    except OSError:                   # unexpected read error — kill + fail closed
                        _kill_group(p); p.wait(); raise
                    if not chunk:                     # EOF — MUST unregister or select() busy-spins
                        sel.unregister(key.fileobj)
                        continue
                    tag, buf, cap = streams[key.fd]
                    buf += chunk
                    if len(buf) > cap:
                        verdict = tag; break
                if verdict:
                    break
        finally:
            sel.close()
        if verdict:
            _kill_group(p)
        rc = p.wait()
    if verdict == "timeout":
        raise BackendTimeout()
    if verdict:
        raise BackendTooBig(verdict)
    return rc, out_buf.decode("utf-8"), err_buf.decode("utf-8", "replace")


def main():
    cfg = load_conf()
    try:
        with open(SIGNALS) as f:
            signals_raw = f.read()
        json.loads(signals_raw)   # sanity parse
    except Exception as e:
        die(f"cannot read/parse {SIGNALS}: {e}")

    # ---- invoke the pluggable backend (the provider-agnostic process contract) ----
    # shlex.split so a BACKEND_CMD with quoted/spaced arguments parses correctly
    # (e.g. `/usr/bin/python3 /opt/my backend.py --flag`), not naive whitespace split.
    cmd = shlex.split(cfg["BACKEND_CMD"])
    # D5: hand the backend a MINIMAL environment — a safe baseline + the model + ONLY the declared
    # secret var (KEY_ENV in backend.conf, default ANTHROPIC_API_KEY). The old `dict(os.environ)`
    # forwarded the API key AND every other inherited variable to the BACKEND_CMD, including to a
    # local/keyless backend with no business seeing the cloud key. (A keyless backend simply has no
    # key in our environ to forward, so the default is safe.)
    base_keep = ("PATH", "HOME", "LANG", "LC_ALL", "LC_CTYPE", "TMPDIR")
    env = {k: os.environ[k] for k in base_keep if k in os.environ}
    env.setdefault("PATH", "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
    env["EDGE_AI_MODEL"] = str(cfg["MODEL"])
    key_env = str(cfg.get("KEY_ENV", "ANTHROPIC_API_KEY")).strip()
    if key_env and key_env in os.environ:
        env[key_env] = os.environ[key_env]
    # Bounded read: the signals file is the child's stdin; stdout/stderr are capped so a runaway
    # backend can't OOM this analyzer (M7). Any failure -> die, leaving the prior intents to expire.
    try:
        rc, out, err = run_backend(cmd, SIGNALS, cfg["BACKEND_TIMEOUT"], env, cfg["MAX_OUTPUT_BYTES"])
    except BackendTimeout:
        die(f"backend {cmd[0]} timed out after {cfg['BACKEND_TIMEOUT']}s")
    except BackendTooBig as e:
        die(f"backend {cmd[0]} exceeded the {e.stream} byte ceiling "
            f"(MAX_OUTPUT_BYTES={cfg['MAX_OUTPUT_BYTES']}) — refusing to buffer a runaway backend")
    except UnicodeDecodeError as e:
        die(f"backend {cmd[0]} stdout not valid UTF-8: {e}")
    except Exception as e:
        die(f"backend {cmd[0]} exec failed: {e}")
    if rc != 0:
        die(f"backend {cmd[0]} rc={rc}: {err.strip()[:300]}")
    try:
        env_doc = json.loads(out)
    except (json.JSONDecodeError, ValueError, RecursionError) as e:
        # RecursionError (deeply-nested JSON) is NOT a JSONDecodeError — catch it so a hostile
        # payload dies gracefully (prior intents self-heal) instead of an uncaught traceback.
        die(f"backend output not parseable JSON: {e}; head={out[:200]!r}")

    # ---- validate envelope shape (jsonschema if available, else manual) ----
    try:
        import jsonschema
        with open(SCHEMA) as f:
            schema = json.load(f)
        jsonschema.validate(env_doc, schema)
    except ImportError:
        if not (isinstance(env_doc, dict) and env_doc.get("version") == 1
                and isinstance(env_doc.get("intents"), list)):
            die("envelope failed manual validation (no jsonschema lib)")
    except Exception as e:
        die(f"envelope failed schema validation: {e}")

    now = int(time.time())
    backend_id = _clean(env_doc.get("backend", cmd[0]), 200)
    applied, proposals = [], []
    # Hard ceiling on TOTAL intents processed. MAX_INTENTS below caps only APPLIED intents; without
    # this a backend returning e.g. 50k propose_base_change intents (well within MAX_OUTPUT_BYTES)
    # would append them all to proposals.jsonl in one run. Bounds the proposals write too.
    all_intents = env_doc.get("intents", [])
    if len(all_intents) > MAX_TOTAL_INTENTS:
        log(f"backend returned {len(all_intents)} intents; processing first {MAX_TOTAL_INTENTS}")
    for it in all_intents[:MAX_TOTAL_INTENTS]:
        if not isinstance(it, dict):
            # Manual validation (the default path — jsonschema is not a declared dep) only checks
            # that `intents` is a list, so a hostile `intents:[1,"x",null]` would reach here and
            # crash `it.get(...)` with an uncaught AttributeError. Skip non-object items instead.
            log(f"drop non-object intent {it!r}"); continue
        action = it.get("action")
        if action == "propose_base_change":
            proposals.append({"ts": now, "backend": backend_id,
                              "description": _clean(it.get("description", ""), 600),
                              "reason": _clean(it.get("reason", ""), 280)})
            continue
        if action not in APPLY_ACTIONS:
            log(f"drop unknown action {action!r}"); continue
        cidr = str(it.get("cidr", "")).strip()
        if not cidr:
            log(f"drop {action}: missing cidr"); continue
        ttl = it.get("ttl", cfg["MIN_TTL"])
        try: ttl = int(ttl)
        except (ValueError, TypeError): ttl = cfg["MIN_TTL"]
        ttl = max(cfg["MIN_TTL"], min(cfg["MAX_TTL"], ttl))   # clamp
        applied.append({
            "action": action, "cidr": cidr, "ttl": ttl, "expires": now + ttl,
            "reason": _clean(it.get("reason", ""), 280),
            "confidence": it.get("confidence"),
        })
        if len(applied) >= cfg["MAX_INTENTS"]:
            log(f"hit MAX_INTENTS={cfg['MAX_INTENTS']}, truncating"); break

    out = {"version": 1, "generated_epoch": now, "backend": backend_id, "intents": applied}
    os.makedirs(os.path.dirname(INTENTS), exist_ok=True)
    tmp = INTENTS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(out, f, separators=(",", ":"))
    os.replace(tmp, INTENTS)

    if proposals:
        with open(PROPOSALS, "a") as f:
            for pr in proposals:
                f.write(json.dumps(pr, separators=(",", ":")) + "\n")

    log(f"backend={backend_id} -> {len(applied)} apply-intents, {len(proposals)} proposals")
    print(json.dumps({"backend": backend_id, "apply_intents": len(applied),
                      "proposals": len(proposals)}))
    return 0

if __name__ == "__main__":
    sys.exit(main())
